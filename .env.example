# Copy to .env.local. Enter actual values privately in the file and Vercel settings.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY
# Copy Supabase Connect > Transaction pooler URI. URL-encode password characters.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:YOUR-ENCODED-PASSWORD@YOUR-POOLER-HOST:6543/postgres
# Only this confirmed Supabase email can initialize a fresh business.
OWNER_EMAIL=pikuholidays@gmail.com

# Optional server-only CA certificate from Supabase Database Settings (PEM).
# Needed if the database certificate is not trusted by the system CA store.
# Paste the full PEM using literal \n between lines; never prefix this name with NEXT_PUBLIC_.
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
